@{
    var heroImagen = "https://plus.unsplash.com/premium_photo-1692049122910-d8b131ed54c1?q=80&w=774&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D";

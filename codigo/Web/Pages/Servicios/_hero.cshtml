<!-- Hero: Experiencias Isme -->
<section class="relative overflow-hidden rounded-lg shadow-sm bg-coffee-bean min-h-[420px] md:min-h-[500px] flex items-center justify-center text-center mb-12"
         style="background-image: linear-gradient(180deg, rgba(43,26,18,0.55) 0%, rgba(43,26,18,0.35) 45%, rgba(43,26,18,0.65) 100%), url('@heroImagen'); background-size: cover; background-position: center;">
    <div class="px-6 md:px-12 py-16 max-w-3xl">
        <h1 class="text-display-hero font-display-hero text-earth-cream leading-none mb-5">
            Experiencias Isme
        </h1>
        <p class="text-body-lg text-earth-cream/85 max-w-2xl mx-auto">
            Sumérjase en la cultura del café a través de nuestras catas y recorridos
            guiados en el corazón de Los Santos.
        </p>
    </div>
</section>

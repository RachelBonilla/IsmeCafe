<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin · Isme Café</title>

    <!-- Tipografías e iconos del diseño -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />

    <!-- Tailwind con el tema de la marca. -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind.config.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />

    <script src="~/react/react-components.js" asp-append-version="true"></script>
</head>
<body class="antialiased min-h-screen font-body-md bg-surface-container-low">
    <div class="flex min-h-screen">
        <!-- Side nav (escritorio) -->
        <partial name="_AdminNavBar" />

        <!-- Columna de contenido -->
        <div class="flex-1 flex flex-col min-w-0">
            <!-- Barra superior (móvil) -->
            <header class="md:hidden flex items-center justify-between bg-primary-container text-earth-cream px-margin-mobile py-4 border-b border-outline">
                <a class="flex items-center gap-2" asp-page="/Productos/Admin">
                    <span class="material-symbols-outlined filled text-gold-accent">local_cafe</span>
                    <span class="text-headline-sm font-headline-sm">Isme Café</span>
                    <span class="text-label-bold font-label-bold uppercase tracking-wider bg-gold-accent/20 text-gold-accent px-2 py-0.5 rounded-full">Admin</span>
                </a>
                <a asp-page="/Productos/Index" class="text-earth-cream/80 hover:text-gold-accent" aria-label="Ver sitio">
                    <span class="material-symbols-outlined">storefront</span>
                </a>
            </header>

            <main class="flex-grow w-full px-margin-mobile md:px-gutter py-stack-md">
                @RenderBody()
            </main>

            <footer class="bg-inverse-surface text-inverse-on-surface/70 text-body-sm w-full py-4 mt-auto">
                <div class="px-margin-mobile md:px-gutter">
                    Panel de administración · Isme Café &copy; 2026
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

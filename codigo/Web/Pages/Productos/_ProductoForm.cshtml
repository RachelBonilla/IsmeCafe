@model Web.Pages.Productos.AdminModel
@{
    var inputClass = "w-full bg-earth-cream/30 border border-outline-variant rounded-lg px-4 py-2 text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary";
}
<section class="lg:col-span-2">
    <form method="post" asp-page-handler="Guardar"
            class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm p-6 space-y-5 lg:sticky lg:top-6">
        <div class="flex items-center gap-2 pb-3 border-b border-outline-variant">
            <span class="material-symbols-outlined filled text-secondary">@(Model.EnEdicion ? "edit" : "add_circle")</span>
            <h2 class="text-headline-sm font-headline-sm text-coffee-bean">
                @(Model.EnEdicion ? "Editar producto" : "Nuevo producto")
            </h2>
        </div>

        <input type="hidden" asp-for="EditId" />
        <div asp-validation-summary="ModelOnly" class="text-status-error text-body-sm"></div>

        <div>
            <label asp-for="Entrada.Nombre" class="block text-body-sm font-label-bold text-on-surface mb-1">Nombre</label>
            <input asp-for="Entrada.Nombre" placeholder="Café de altura 250g" class="@inputClass" />
            <span asp-validation-for="Entrada.Nombre" class="text-status-error text-body-sm"></span>
        </div>

        <div>
            <label asp-for="Entrada.Descripcion" class="block text-body-sm font-label-bold text-on-surface mb-1">Descripción</label>
            <textarea asp-for="Entrada.Descripcion" rows="3" placeholder="Notas de cata, origen, proceso…" class="@inputClass"></textarea>
            <span asp-validation-for="Entrada.Descripcion" class="text-status-error text-body-sm"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Entrada.Precio" class="block text-body-sm font-label-bold text-on-surface mb-1">Precio (₡)</label>
                <input asp-for="Entrada.Precio" type="number" step="0.01" min="0.01" placeholder="4500" class="@inputClass" />
                <span asp-validation-for="Entrada.Precio" class="text-status-error text-body-sm"></span>
            </div>
            <div>
                <label asp-for="Entrada.Cantidad" class="block text-body-sm font-label-bold text-on-surface mb-1">Cantidad</label>
                <input asp-for="Entrada.Cantidad" type="number" min="0" placeholder="20" class="@inputClass" />
                <span asp-validation-for="Entrada.Cantidad" class="text-status-error text-body-sm"></span>
            </div>
        </div>

        <div>
            <label asp-for="Entrada.IdCategoria" class="block text-body-sm font-label-bold text-on-surface mb-1">Categoría</label>
            <div class="relative">
                <select asp-for="Entrada.IdCategoria" asp-items="Model.Categorias"
                        class="w-full appearance-none bg-surface-container border border-outline-variant rounded-lg px-4 py-2 pr-10 text-body-md focus:outline-none focus:border-primary cursor-pointer">
                    <option value="">Seleccione una categoría…</option>
                </select>
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant">expand_more</span>
            </div>
            <span asp-validation-for="Entrada.IdCategoria" class="text-status-error text-body-sm"></span>
        </div>

        <div>
            <label asp-for="Entrada.Imagen" class="block text-body-sm font-label-bold text-on-surface mb-1">Imagen (URL)</label>
            <input asp-for="Entrada.Imagen" placeholder="https://…/foto.jpg" class="@inputClass" />
            <span asp-validation-for="Entrada.Imagen" class="text-status-error text-body-sm"></span>
        </div>

        <label class="flex items-center gap-2 text-body-md text-on-surface">
            <input asp-for="Entrada.Activo" type="checkbox" class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary" />
            Visible en el catálogo (activo)
        </label>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit"
                    class="bg-primary text-on-primary px-5 py-2.5 rounded-full text-label-bold font-label-bold hover:bg-primary/90 transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined filled">save</span>
                @(Model.EnEdicion ? "Guardar cambios" : "Registrar producto")
            </button>
            @if (Model.EnEdicion)
            {
                <a asp-page="/Productos/Admin"
                    class="text-on-surface-variant hover:text-primary transition-colors text-label-bold font-label-bold">Cancelar</a>
            }
        </div>
    </form>
</section>

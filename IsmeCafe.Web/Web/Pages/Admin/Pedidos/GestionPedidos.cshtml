@page
@model Web.Pages.Admin.Pedidos.GestionPedidosModel

@{
    ViewData["Title"] = "Pedidos";
    Layout = "_AdminLayout";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-label-bold font-label-bold uppercase tracking-wider text-secondary mb-1">
            Gestión de pedidos
        </p>

        <h1 class="text-headline-lg font-headline-lg text-coffee-bean">
            Pedidos
        </h1>

        <p class="text-body-sm text-on-surface-variant mt-1">
            Consulta y administra los pedidos realizados por los clientes.
        </p>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl px-5 py-3 text-center">
        <p class="text-headline-sm font-headline-sm text-coffee-bean">
            @Model.Pedidos.Count()
        </p>

        <p class="text-body-sm text-on-surface-variant">
            Totales
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="mb-6 rounded-lg border px-4 py-3 text-body-sm @(Model.EsExito
                        ? "border-status-success bg-status-success/10 text-status-success"
                        : "border-status-error bg-status-error/10 text-status-error")">

        @Model.Mensaje
    </div>
}

@if (!Model.Pedidos.Any())
{
    <div class="text-center py-16 text-on-surface-variant">

        <span class="material-symbols-outlined" style="font-size:48px">
            receipt_long
        </span>

        <p class="mt-2 text-body-md">
            No hay pedidos registrados.
        </p>

    </div>
}
else
{
    <!-- Filtros -->
    <div class="mb-5 bg-surface-container-lowest border border-outline-variant rounded-xl p-4">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <div>
                <label class="block text-body-sm font-label-bold mb-2">
                    Buscar
                </label>

                <div class="relative">

                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">
                        search
                    </span>

                    <input id="filtroBusqueda"
                           type="text"
                           placeholder="Pedido o cliente..."
                           oninput="filtrarPedidos()"
                           class="w-full border border-outline-variant rounded-lg pl-10 pr-4 py-2.5 bg-surface-container-lowest" />

                </div>
            </div>

            <div>
                <label class="block text-body-sm font-label-bold mb-2">
                    Estado
                </label>

                <select id="filtroEstado" onchange="filtrarPedidos()"
                        class="w-full border border-outline-variant rounded-lg px-4 py-2.5 bg-surface-container-lowest">

                    <option value="">
                        Todos los estados
                    </option>

                    @foreach (var estado in Model.Estados)
                    {
                        <option value="@estado.Nombre.ToLower()">
                            @estado.Nombre
                        </option>
                    }

                </select>
            </div>

            <div class="flex items-end">

                <button type="button" onclick="limpiarFiltros()"
                        class="inline-flex items-center gap-2 border border-outline-variant px-5 py-2.5 rounded-full hover:bg-surface-container transition-colors">

                    <span class="material-symbols-outlined">
                        filter_alt_off
                    </span>

                    Limpiar filtros
                </button>

            </div>

        </div>

    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto rounded-xl border border-outline-variant">

        <table class="w-full text-body-sm">

            <thead class="bg-surface-container text-on-surface-variant font-label-bold text-label-bold">

                <tr>
                    <th class="text-left px-4 py-3">Pedido</th>
                    <th class="text-left px-4 py-3">Cliente</th>
                    <th class="text-left px-4 py-3">Fecha</th>
                    <th class="text-left px-4 py-3">Estado</th>
                    <th class="text-right px-4 py-3">Total</th>
                    <th class="text-right px-4 py-3">Acciones</th>
                </tr>

            </thead>

            <tbody class="divide-y divide-outline-variant">

                @foreach (var pedido in Model.Pedidos)
                {
                    var claseEstado = pedido.Estado switch
                    {
                        "Pendiente" => "bg-yellow-100 text-yellow-800",
                        "En preparación" => "bg-blue-100 text-blue-800",
                        "Listo" => "bg-green-100 text-green-800",
                        "Entregado" => "bg-emerald-100 text-emerald-800",
                        "Cancelado" => "bg-red-100 text-red-800",
                        _ => "bg-gray-100 text-gray-700"
                    };

                    <tr class="fila-pedido bg-surface-container-lowest hover:bg-surface-container-low transition-colors"
                        data-pedido="@pedido.NumeroPedido"
                        data-cliente="@pedido.Cliente.ToLower()"
                        data-estado="@pedido.Estado.ToLower()">

                        <td class="px-4 py-3 font-medium text-coffee-bean">
                            #@pedido.NumeroPedido
                        </td>

                        <td class="px-4 py-3 text-on-surface-variant">
                            @pedido.Cliente
                        </td>

                        <td class="px-4 py-3 text-on-surface-variant">
                            @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td class="px-4 py-3">

                            <span class="@claseEstado px-3 py-1 rounded-full text-xs font-bold">
                                @pedido.Estado
                            </span>

                        </td>

                        <td class="px-4 py-3 text-right font-medium text-coffee-bean">
                            ₡@pedido.Total.ToString("N2")
                        </td>

                        <td class="px-4 py-3 text-right">

                            <button type="button" onclick="abrirModal('modalPedido-@pedido.Id')"
                                    class="p-2 rounded-full text-on-surface-variant hover:text-primary hover:bg-earth-cream transition-colors"
                                    title="Gestionar pedido">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Mensaje cuando los filtros no encuentran resultados -->
    <div id="sinResultados" class="hidden text-center py-12 text-on-surface-variant">

        <span class="material-symbols-outlined"
              style="font-size:42px">
            search_off
        </span>

        <p class="mt-2 text-body-md">
            No se encontraron pedidos con los filtros seleccionados.
        </p>

    </div>

    <!-- Modales -->
    @foreach (var pedido in Model.Pedidos)
    {
        var claseEstadoModal = pedido.Estado switch
        {
            "Pendiente" => "bg-yellow-100 text-yellow-800",
            "En preparación" => "bg-blue-100 text-blue-800",
            "Listo" => "bg-green-100 text-green-800",
            "Entregado" => "bg-emerald-100 text-emerald-800",
            "Cancelado" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-700"
        };

        <div id="modalPedido-@pedido.Id"
             class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">

            <div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-xl">

                <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-outline-variant">

                    <div>

                        <p class="text-label-bold font-label-bold uppercase tracking-wider text-secondary">
                            Gestionar pedido
                        </p>

                        <h2 class="text-headline-sm font-headline-sm text-coffee-bean">
                            Pedido #@pedido.NumeroPedido
                        </h2>

                    </div>

                    <button type="button" nclick="cerrarModal('modalPedido-@pedido.Id')" class="text-on-surface-variant hover:text-primary transition-colors">

                        <span class="material-symbols-outlined">
                            close
                        </span>

                    </button>

                </div>

                <form method="post" asp-page-handler="ActualizarEstado" class="px-6 py-6 space-y-5">

                    <input type="hidden" name="idPedido" value="@pedido.Id" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <div>

                            <p class="text-body-sm font-label-bold text-on-surface mb-1">
                                Cliente
                            </p>

                            <p class="text-body-md text-on-surface-variant">
                                @pedido.Cliente
                            </p>

                        </div>

                        <div>

                            <p class="text-body-sm font-label-bold text-on-surface mb-1">
                                Fecha
                            </p>

                            <p class="text-body-md text-on-surface-variant">
                                @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </p>

                        </div>

                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <div>

                            <p class="text-body-sm font-label-bold text-on-surface mb-1">
                                Total
                            </p>

                            <p class="text-body-md font-medium text-coffee-bean">
                                ₡@pedido.Total.ToString("N2")
                            </p>

                        </div>

                        <div>

                            <p class="text-body-sm font-label-bold text-on-surface mb-1">
                                Estado actual
                            </p>

                            <span class="@claseEstadoModal inline-block px-3 py-1 rounded-full text-xs font-bold">
                                @pedido.Estado
                            </span>

                        </div>

                    </div>

                    <div>

                        <label for="estado-@pedido.Id"
                               class="block mb-2 font-semibold">
                            Nuevo estado
                        </label>

                        <select id="estado-@pedido.Id" name="idEstado" required class="w-full border border-outline-variant rounded-lg px-4 py-3 bg-surface-container-lowest">

                            @foreach (var estado in Model.Estados)
                            {
                                if (estado.IdEstado == pedido.IdEstado)
                                {
                                    <option value="@estado.IdEstado" selected> @estado.Nombre  </option>
                                }
                                else
                                {
                                    <option value="@estado.IdEstado">@estado.Nombre </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant">

                        <button type="button"
                                onclick="cerrarModal('modalPedido-@pedido.Id')"
                                class="px-5 py-2.5 rounded-full text-on-surface-variant hover:bg-surface-container transition-colors">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-2.5 rounded-full hover:bg-primary/90 transition-colors">

                            <span class="material-symbols-outlined">
                                save
                            </span>

                            Guardar cambios

                        </button>

                    </div>

                </form>

            </div>

        </div>
    }
}

@section Scripts
{
    <script>
        function abrirModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function cerrarModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function filtrarPedidos() {

            const busqueda = document.getElementById('filtroBusqueda').value.toLowerCase().trim();
            const estado = document.getElementById('filtroEstado').value.toLowerCase();
            const filas = document.querySelectorAll('.fila-pedido');
            let visibles = 0;

            filas.forEach(fila => {

                const pedido = fila.dataset.pedido.toLowerCase();
                const cliente = fila.dataset.cliente;
                const estadoPedido = fila.dataset.estado;

                const coincideBusqueda = !busqueda || pedido.includes(busqueda) || cliente.includes(busqueda);
                const coincideEstado = !estado || estadoPedido === estado;
                const mostrar = coincideBusqueda && coincideEstado;

                fila.style.display = mostrar ? '' : 'none';

                if (mostrar) {
                    visibles++;
                }
            });

            const sinResultados =
                document.getElementById('sinResultados');

            if (visibles === 0) {
                sinResultados.classList.remove('hidden');
            }
            else {
                sinResultados.classList.add('hidden');
            }
        }

        function limpiarFiltros() {

            document.getElementById('filtroBusqueda').value = '';
            document.getElementById('filtroEstado').value = '';

            filtrarPedidos();
        }
    </script>
}
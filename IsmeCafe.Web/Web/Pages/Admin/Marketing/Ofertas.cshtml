@page
@model Web.Pages.Admin.Marketing.OfertasModel
@{
    ViewData["Title"] = "Ofertas";
    Layout = "_AdminLayout";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <p class="text-label-bold font-label-bold uppercase tracking-wider text-secondary mb-1">Marketing</p>
        <h1 class="text-headline-lg font-headline-lg text-coffee-bean">Ofertas</h1>
        <p class="text-body-sm text-on-surface-variant mt-1">Gestión de ofertas y combos</p>
    </div>
    <button type="button" onclick="abrirModal('modalCrearOferta')"
            class="flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-full font-label-bold text-label-bold hover:bg-primary/90 transition-colors">
        <span class="material-symbols-outlined" style="font-size:18px">add</span>
        Nueva oferta
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="mb-6 rounded-lg border px-4 py-3 text-body-sm @(Model.EsExito
                 ? "border-status-success bg-status-success/10 text-status-success"
                 : "border-status-error bg-status-error/10 text-status-error")">
        @Model.Mensaje
    </div>
}

@if (Model.Ofertas.Count == 0)
{
    <div class="text-center py-16 text-on-surface-variant">
        <span class="material-symbols-outlined" style="font-size:48px">local_offer</span>
        <p class="mt-2 text-body-md">No hay ofertas registradas.</p>
    </div>
}
else
{
    <div class="overflow-x-auto rounded-xl border border-outline-variant">
        <table class="w-full text-body-sm">
            <thead class="bg-surface-container text-on-surface-variant font-label-bold text-label-bold">
                <tr>
                    <th class="text-left px-4 py-3">Nombre</th>
                    <th class="text-left px-4 py-3">Tipo</th>
                    <th class="text-left px-4 py-3">Productos</th>
                    <th class="text-left px-4 py-3">Vigencia</th>
                    <th class="text-left px-4 py-3">Estado</th>
                    <th class="text-left px-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var o in Model.Ofertas)
                {
                    var vigente = o.Activo && DateTime.Now >= o.FechaInicio && DateTime.Now <= o.FechaFin;
                    <tr class="bg-surface-container-lowest hover:bg-surface-container-low transition-colors">
                        <td class="px-4 py-3">
                            <p class="font-medium text-coffee-bean">@o.Nombre</p>
                            @if (!string.IsNullOrWhiteSpace(o.Descripcion))
                            {
                                <p class="text-xs text-on-surface-variant">@o.Descripcion</p>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <span class="bg-primary-container text-on-primary px-2 py-1 rounded-full text-xs font-bold">@o.TipoOferta</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="bg-secondary-container text-on-secondary-container px-2 py-1 rounded-full text-xs font-bold"
                                  title="@string.Join(", ", o.Productos.Select(p => p.NombreProducto))">
                                @o.Productos.Count producto(s)
                            </span>
                        </td>
                        <td class="px-4 py-3 text-on-surface-variant">
                            @o.FechaInicio.ToString("dd/MM/yyyy") → @o.FechaFin.ToString("dd/MM/yyyy")
                        </td>
                        <td class="px-4 py-3">
                            @if (vigente)
                            {
                                <span class="bg-status-success/20 text-status-success px-2 py-1 rounded-full text-xs font-bold">Vigente</span>
                            }
                            else
                            {
                                <span class="bg-surface-container text-on-surface-variant px-2 py-1 rounded-full text-xs font-bold">Inactiva</span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="abrirModal('modalEditarOferta-@o.Id')"
                                        class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors" title="Editar">
                                    <span class="material-symbols-outlined" style="font-size:18px">edit</span>
                                </button>
                                <form method="post" asp-page-handler="Eliminar" class="inline"
                                      onsubmit="return confirm('¿Desactivar la oferta &quot;@o.Nombre&quot;?');">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <button type="submit"
                                            class="p-1.5 rounded-lg text-on-surface-variant hover:bg-error-container hover:text-error transition-colors" title="Desactivar">
                                        <span class="material-symbols-outlined" style="font-size:18px">block</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!--Modal nueva oferta-->
<div id="modalCrearOferta" class="@(Model.AbrirModalCrear ? "" : "hidden") fixed inset-0 bg-inverse-surface/50 flex items-center justify-center z-50 p-4">
    <div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-outline-variant sticky top-0 bg-surface-container-lowest">
            <h2 class="text-headline-sm font-headline-sm text-coffee-bean">Nueva oferta</h2>
            <button type="button" onclick="cerrarModal('modalCrearOferta')" class="text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="Guardar" class="px-6 py-4 flex flex-col gap-4">
            <div asp-validation-summary="ModelOnly" class="text-status-error text-body-sm"></div>

            <div class="flex flex-col gap-1">
                <label class="text-label-bold font-label-bold text-on-surface-variant">Nombre</label>
                <input name="Datos.Nombre" placeholder="Ej: 2x1 Café de altura"
                       class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary" />
                <span asp-validation-for="Datos.Nombre" class="text-status-error text-body-sm"></span>
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-label-bold font-label-bold text-on-surface-variant">Descripción</label>
                <textarea name="Datos.Descripcion" rows="2" placeholder="Descripción opcional"
                          class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary resize-none"></textarea>
            </div>

            <div class="grid grid-cols-1 gap-3">
                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Tipo de oferta</label>
                    <select name="Datos.TipoOferta" class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary">
                        @foreach (var t in Web.Pages.Admin.Marketing.OfertasModel.TiposOferta)
                        {
                            <option value="@t" selected="@(t == Model.Datos.TipoOferta)">@t</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Fecha inicio</label>
                    <input name="Datos.FechaInicio" type="datetime-local"
                           class="border border-outline-variant rounded-lg px-3 py-2 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                </div>
                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Fecha fin</label>
                    <input name="Datos.FechaFin" type="datetime-local"
                           class="border border-outline-variant rounded-lg px-3 py-2 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-label-bold font-label-bold text-on-surface-variant">
                    Productos incluidos
                </label>
                <div class="border border-outline-variant rounded-lg divide-y divide-outline-variant max-h-48 overflow-y-auto">
                    @for (int i = 0; i < Model.Productos.Count; i++)
                    {
                        var p = Model.Productos[i];
                        <div class="flex items-center justify-between px-3 py-2 bg-surface">
                            <label class="flex items-center gap-2 cursor-pointer flex-1">
                                <input type="checkbox" name="Lineas[@i].Incluido" value="true" class="w-4 h-4 accent-primary" />
                                <input type="hidden" name="Lineas[@i].IdProducto" value="@p.Id" />
                                <input type="hidden" name="Lineas[@i].Nombre" value="@p.Nombre" />
                                <input type="hidden" name="Lineas[@i].Precio" value="@p.Precio" />
                                <span class="text-body-sm text-on-surface">@p.Nombre</span>
                                <span class="text-xs text-on-surface-variant">₡@p.Precio.ToString("N0")</span>
                            </label>
                            <div class="flex items-center gap-1">
                                <span class="text-xs text-on-surface-variant">Cant:</span>
                                <input type="number" name="Lineas[@i].Cantidad" value="1" min="1" max="99"
                                       class="w-14 border border-outline-variant rounded px-2 py-0.5 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="Datos.Activo" value="true" checked class="w-4 h-4 accent-primary" />
                <span class="text-body-md text-on-surface">Activa</span>
            </label>

            <div class="flex justify-end gap-3 pt-2 border-t border-outline-variant">
                <button type="button" onclick="cerrarModal('modalCrearOferta')"
                        class="px-4 py-2 rounded-full text-label-bold font-label-bold text-on-surface-variant hover:bg-surface-container transition-colors">
                    Cancelar
                </button>
                <button type="submit"
                        class="px-4 py-2 rounded-full text-label-bold font-label-bold bg-primary text-on-primary hover:bg-primary/90 transition-colors">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<!--Modal de edición de oferta-->
@foreach (var oferta in Model.Ofertas)
{
    <div id="modalEditarOferta-@oferta.Id" class="@(Model.AbrirModalEditar == oferta.Id ? "" : "hidden") fixed inset-0 bg-inverse-surface/50 flex items-center justify-center z-50 p-4">
        <div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-outline-variant sticky top-0 bg-surface-container-lowest">
                <h2 class="text-headline-sm font-headline-sm text-coffee-bean">Editar oferta</h2>
                <button type="button" onclick="cerrarModal('modalEditarOferta-@oferta.Id')" class="text-on-surface-variant hover:text-primary transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form method="post" asp-page-handler="Guardar" class="px-6 py-4 flex flex-col gap-4">
                <input type="hidden" name="EditId" value="@oferta.Id" />
                <div asp-validation-summary="ModelOnly" class="text-status-error text-body-sm"></div>

                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Nombre</label>
                    <input name="Datos.Nombre" value="@oferta.Nombre"
                           class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary" />
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Descripción</label>
                    <textarea name="Datos.Descripcion" rows="2"
                              class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary resize-none">@oferta.Descripcion</textarea>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Tipo de oferta</label>
                    <select name="Datos.TipoOferta" class="border border-outline-variant rounded-lg px-3 py-2 text-body-md bg-surface focus:outline-none focus:border-primary">
                        @foreach (var t in Web.Pages.Admin.Marketing.OfertasModel.TiposOferta)
                        {
                            <option value="@t" selected="@(t == oferta.TipoOferta)">@t</option>
                        }
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1">
                        <label class="text-label-bold font-label-bold text-on-surface-variant">Fecha inicio</label>
                        <input name="Datos.FechaInicio" type="datetime-local" value="@oferta.FechaInicio.ToString("yyyy-MM-ddTHH:mm")"
                               class="border border-outline-variant rounded-lg px-3 py-2 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-label-bold font-label-bold text-on-surface-variant">Fecha fin</label>
                        <input name="Datos.FechaFin" type="datetime-local" value="@oferta.FechaFin.ToString("yyyy-MM-ddTHH:mm")"
                               class="border border-outline-variant rounded-lg px-3 py-2 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-label-bold font-label-bold text-on-surface-variant">Productos incluidos</label>
                    <div class="border border-outline-variant rounded-lg divide-y divide-outline-variant max-h-48 overflow-y-auto">
                        @for (int i = 0; i < Model.Productos.Count; i++)
                        {
                            var p = Model.Productos[i];
                            var incluido = oferta.Productos.FirstOrDefault(op => op.IdProducto == p.Id);
                            <div class="flex items-center justify-between px-3 py-2 bg-surface">
                                <label class="flex items-center gap-2 cursor-pointer flex-1">
                                    <input type="checkbox" name="Lineas[@i].Incluido" value="true" checked="@(incluido != null)" class="w-4 h-4 accent-primary" />
                                    <input type="hidden" name="Lineas[@i].IdProducto" value="@p.Id" />
                                    <input type="hidden" name="Lineas[@i].Nombre" value="@p.Nombre" />
                                    <input type="hidden" name="Lineas[@i].Precio" value="@p.Precio" />
                                    <span class="text-body-sm text-on-surface">@p.Nombre</span>
                                    <span class="text-xs text-on-surface-variant">₡@p.Precio.ToString("N0")</span>
                                </label>
                                <div class="flex items-center gap-1">
                                    <span class="text-xs text-on-surface-variant">Cant:</span>
                                    <input type="number" name="Lineas[@i].Cantidad" value="@(incluido?.Cantidad ?? 1)" min="1" max="99"
                                           class="w-14 border border-outline-variant rounded px-2 py-0.5 text-body-sm bg-surface focus:outline-none focus:border-primary" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="Datos.Activo" value="true" checked="@oferta.Activo" class="w-4 h-4 accent-primary" />
                    <span class="text-body-md text-on-surface">Activa</span>
                </label>

                <div class="flex justify-end gap-3 pt-2 border-t border-outline-variant">
                    <button type="button" onclick="cerrarModal('modalEditarOferta-@oferta.Id')"
                            class="px-4 py-2 rounded-full text-label-bold font-label-bold text-on-surface-variant hover:bg-surface-container transition-colors">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="px-4 py-2 rounded-full text-label-bold font-label-bold bg-primary text-on-primary hover:bg-primary/90 transition-colors">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
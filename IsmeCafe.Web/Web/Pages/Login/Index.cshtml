@page
@model Web.Pages.Login.IndexModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<section class="flex justify-center items-center py-16">
    <div class="w-full max-w-md bg-white border rounded-2xl p-8 shadow-sm">

        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-coffee-bean mb-2">
                ISME Cafe
            </h1>
            <p class="text-on-surface">
                Ingresa tus credenciales para continuar
            </p>
        </div>

        <form method="post" class="space-y-6">

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-semibold text-center bg-red-50 p-2 rounded-md empty:hidden"></div>

            <div>
                <label asp-for="Input.Correo" class="block text-sm font-medium text-coffee-bean mb-2">
                    Correo Electrónico
                </label>
                <input asp-for="Input.Correo" type="email" required
                       placeholder="ejemplo@ismecafe.com"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Correo" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Contrasena" class="block text-sm font-medium text-coffee-bean mb-2">
                    Contraseña
                </label>
                <input asp-for="Input.Contrasena"
                       type="password"
                       required
                       minlength="8"
                       autocomplete="current-password"
                       placeholder="••••••••"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <p class="text-xs text-on-surface-variant mt-2">
                    Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.
                </p>
                <span asp-validation-for="Input.Contrasena" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="flex items-center justify-between flex-wrap gap-2 text-sm">
                <label class="flex items-center space-x-2 text-on-surface cursor-pointer">
                    <input asp-for="Input.EsEmpleado" type="checkbox"
                           class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                    <span>Soy empleado</span>
                </label>

                <a asp-page="/Login/RecuperarContrasena"
                   class="text-primary hover:underline font-medium">
                    ¿Olvidó su contraseña?
                </a>
            </div>

            <div class="pt-2">
                <button type="submit"
                        class="w-full bg-primary text-white font-semibold px-6 py-3 rounded-full hover:bg-opacity-90 transition-all shadow-sm">
                    Iniciar Sesión
                </button>
            </div>

        </form>

        <div class="mt-6 text-center text-sm text-on-surface">
            ¿No tienes una cuenta?
            <a asp-page="/Login/RegistrarCliente" class="text-primary hover:underline font-medium">
                Regístrate aquí
            </a>
        </div>

    </div>
</section>
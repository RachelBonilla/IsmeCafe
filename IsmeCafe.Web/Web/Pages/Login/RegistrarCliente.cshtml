@page
@model Web.Pages.Login.RegistrarClienteModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="flex justify-center items-center py-16">
    <div class="w-full max-w-md bg-white border rounded-2xl p-8 shadow-sm">

        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-coffee-bean mb-2">
                Crear cuenta
            </h1>
            <p class="text-on-surface">
                Registrate para comprar y acumular beneficios
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="text-red-600 text-sm font-semibold text-center bg-red-50 p-2 rounded-md mb-4">
                @Model.Mensaje
            </div>
        }

        <form method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-semibold text-center bg-red-50 p-2 rounded-md empty:hidden"></div>

            <div>
                <label asp-for="Input.Nombre" class="block text-sm font-medium text-coffee-bean mb-2">Nombre</label>
                <input asp-for="Input.Nombre" type="text"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Nombre" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Apellidos" class="block text-sm font-medium text-coffee-bean mb-2">Apellidos</label>
                <input asp-for="Input.Apellidos" type="text"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Apellidos" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Correo" class="block text-sm font-medium text-coffee-bean mb-2">Correo electrónico</label>
                <input asp-for="Input.Correo" type="email" placeholder="ejemplo@ismecafe.com"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Correo" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Telefono" class="block text-sm font-medium text-coffee-bean mb-2">Teléfono</label>
                <input asp-for="Input.Telefono" type="tel" placeholder="8888-8888"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Telefono" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="Input.Contrasena" class="block text-sm font-medium text-coffee-bean mb-2">Contraseña</label>
                <input asp-for="Input.Contrasena" type="password" placeholder="••••••••"
                       class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-primary" />
                <span asp-validation-for="Input.Contrasena" class="text-red-500 text-xs mt-1"></span>
            </div>

            <label class="flex items-start gap-2 text-sm text-on-surface cursor-pointer">
                <input asp-for="Input.SuscritoMarketing" type="checkbox"
                       class="mt-1 w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                <span>Deseo recibir información sobre los productos de Isme Café por medio de mi correo electrónico</span>
            </label>

            <div class="pt-2">
                <button type="submit"
                        class="w-full bg-primary text-white font-semibold px-6 py-3 rounded-full hover:bg-opacity-90 transition-all shadow-sm">
                    Crear cuenta
                </button>
            </div>
        </form>

        <div class="mt-6 text-center text-sm text-on-surface">
            ¿Ya tenés una cuenta?
            <a asp-page="/Login/Index" class="text-primary hover:underline font-medium">
                Iniciá sesión
            </a>
        </div>

    </div>
</section>
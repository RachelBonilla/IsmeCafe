@page
@model Web.Pages.Reservas.CrearModel

@{
    ViewData["Title"] = "Reservar Servicio";
}

<div class="max-w-3xl mx-auto py-10 px-4">

    <div class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm p-8">

        <div class="mb-8">
            <h1 class="text-headline-lg font-headline-lg text-coffee-bean">
                Reservar servicio
            </h1>

            <p class="mt-2 text-on-surface-variant">
                Completa la información para solicitar tu reserva.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="mb-6 p-4 rounded-lg bg-green-100 text-green-800">
                @Model.Mensaje
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-6 p-4 rounded-lg bg-red-100 text-red-800">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form method="post">

            <input type="hidden" asp-for="IdServicio" />

            <div class="mb-5">
                <label asp-for="NombreCliente"
                       class="block mb-2 font-semibold">
                    Nombre completo
                </label>

                <input asp-for="NombreCliente"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3"
                       placeholder="Ingrese su nombre completo" />

                <span asp-validation-for="NombreCliente"
                      class="text-red-600 text-sm">
                </span>
            </div>

            <div class="mb-5">
                <label asp-for="Correo"
                       class="block mb-2 font-semibold">
                    Correo electrónico
                </label>

                <input asp-for="Correo"
                       type="email"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3"
                       placeholder="correo@ejemplo.com" />

                <span asp-validation-for="Correo"
                      class="text-red-600 text-sm">
                </span>
            </div>

            <div class="mb-5">
                <label asp-for="Telefono"
                       class="block mb-2 font-semibold">
                    Teléfono
                </label>

                <input asp-for="Telefono"
                       type="tel"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3"
                       placeholder="8888-8888" />

                <span asp-validation-for="Telefono"
                      class="text-red-600 text-sm">
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div>
                    <label asp-for="FechaReserva"
                           class="block mb-2 font-semibold">
                        Fecha de reserva
                    </label>

                    <input asp-for="FechaReserva"
                           type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full border border-gray-300 rounded-lg px-4 py-3" />

                    <span asp-validation-for="FechaReserva"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <div>
                    <label class="block mb-2 font-semibold">
                        Hora
                    </label>

                    <div class="grid grid-cols-2 gap-3">

                        <select asp-for="HoraSeleccionada"
                                class="w-full border border-gray-300 rounded-lg px-4 py-3">

                            <option value="">Seleccione</option>

                            <option value="7:00">7:00</option>
                            <option value="7:30">7:30</option>
                            <option value="8:00">8:00</option>
                            <option value="8:30">8:30</option>
                            <option value="9:00">9:00</option>
                            <option value="9:30">9:30</option>
                            <option value="10:00">10:00</option>
                            <option value="10:30">10:30</option>
                            <option value="11:00">11:00</option>
                            <option value="11:30">11:30</option>
                            <option value="12:00">12:00</option>
                            <option value="12:30">12:30</option>
                            <option value="1:00">1:00</option>
                            <option value="1:30">1:30</option>
                            <option value="2:00">2:00</option>
                            <option value="2:30">2:30</option>
                            <option value="3:00">3:00</option>
                            <option value="3:30">3:30</option>
                            <option value="4:00">4:00</option>
                            <option value="4:30">4:30</option>
                            <option value="5:00">5:00</option>
                            <option value="5:30">5:30</option>
                            <option value="6:00">6:00</option>

                        </select>

                        <select asp-for="Periodo"
                                class="w-full border border-gray-300 rounded-lg px-4 py-3">

                            <option value="">AM / PM</option>
                            <option value="AM">AM</option>
                            <option value="PM">PM</option>

                        </select>

                    </div>

                    <span asp-validation-for="HoraSeleccionada"
                          class="text-red-600 text-sm">
                    </span>

                    <span asp-validation-for="Periodo"
                          class="text-red-600 text-sm block">
                    </span>
                </div>

            </div>

            <div class="mt-5 mb-5">
                <label asp-for="CantidadPersonas"
                       class="block mb-2 font-semibold">
                    Cantidad de personas
                </label>

                <input asp-for="CantidadPersonas"
                       type="number"
                       min="1"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3" />

                <span asp-validation-for="CantidadPersonas"
                      class="text-red-600 text-sm">
                </span>
            </div>

            <div class="flex gap-3">

                <button type="submit"
                        class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-full hover:bg-primary/90 transition-colors">

                    <span class="material-symbols-outlined">
                        event_available
                    </span>

                    Confirmar reserva
                </button>

                <a asp-page="/Servicios/CatalogoServicios"
                   class="inline-flex items-center px-6 py-3 rounded-full border border-gray-300 hover:bg-gray-100 transition-colors">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
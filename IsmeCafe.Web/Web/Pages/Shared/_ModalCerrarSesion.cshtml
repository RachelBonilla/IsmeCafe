<div id="modalCerrarSesion"
     class="hidden fixed inset-0 z-[100] bg-coffee-bean/60 px-4 flex items-center justify-center">

    <div class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-xl border border-outline-variant p-7">

        <div class="w-14 h-14 rounded-full bg-gold-accent/20 text-primary flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-3xl">logout</span>
        </div>

        <h2 class="text-headline-sm font-headline-sm text-coffee-bean mb-3">
            ¿Deseas cerrar sesión?
        </h2>

        <p class="text-on-surface-variant text-body-md leading-6 mb-7">
            Tendrás que iniciar sesión nuevamente para acceder a tu cuenta, carrito y pedidos.
        </p>

        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">

            <button type="button"
                    onclick="cerrarModalCerrarSesion()"
                    class="px-5 py-2.5 rounded-full border border-outline-variant text-on-surface font-label-bold hover:bg-surface-container transition-colors">
                Cancelar
            </button>

            <form method="post" asp-page="/Login/LogOut">
                <button type="submit"
                        class="w-full px-5 py-2.5 rounded-full bg-primary text-on-primary font-label-bold hover:bg-primary/90 transition-colors">
                    Sí, cerrar sesión
                </button>
            </form>

        </div>
    </div>
</div>

<script>
    function abrirModalCerrarSesion() {
        document.getElementById("modalCerrarSesion").classList.remove("hidden");
    }

    function cerrarModalCerrarSesion() {
        document.getElementById("modalCerrarSesion").classList.add("hidden");
    }
</script>
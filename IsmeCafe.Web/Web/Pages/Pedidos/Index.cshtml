@page
@model Web.Pages.Pedidos.IndexModel

@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter py-8">

    <div class="mb-8">
        <h1 class="text-headline-lg font-headline-lg text-coffee-bean">
            Mis pedidos
        </h1>

        <p class="text-on-surface-variant mt-2">
            Consulta los pedidos que has realizado.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="mb-6 rounded-lg border border-red-300 bg-red-50 text-red-700 px-4 py-3">
            @Model.Error
        </div>
    }

    @if (!Model.Pedidos.Any())
    {
        <div class="rounded-lg border border-outline-variant
            bg-surface-container-low px-6 py-10 text-center">

            <span class="material-symbols-outlined text-4xl text-coffee-bean mb-3">
                receipt_long
            </span>

            <p class="text-lg text-coffee-bean font-semibold">
                Aún no has realizado pedidos.
            </p>

            <p class="text-on-surface-variant mt-2 mb-5">
                Cuando realices una compra aparecerá aquí.
            </p>

            <a asp-page="/Productos/Index"
               class="inline-flex items-center gap-2
                bg-primary text-on-primary
                px-5 py-2.5 rounded-full
                text-label-bold font-label-bold
                hover:bg-primary/90 transition-colors">

                <span class="material-symbols-outlined">
                    shopping_bag
                </span>

                Ver productos
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg
            border border-outline-variant bg-white">

            <table class="w-full text-left">

                <thead class="bg-earth-cream/40 text-coffee-bean">
                    <tr>
                        <th class="px-4 py-3">
                            Pedido
                        </th>

                        <th class="px-4 py-3">
                            Fecha
                        </th>

                        <th class="px-4 py-3">
                            Estado
                        </th>

                        <th class="px-4 py-3 text-right">
                            Total
                        </th>

                        <th class="px-4 py-3 text-center">
                            Detalle
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pedido in Model.Pedidos)
                    {
                        <tr class="border-t border-outline-variant
                            hover:bg-earth-cream/20
                            transition-colors">

                            <td class="px-4 py-4">
                                <span class="font-semibold text-coffee-bean">
                                    #@pedido.NumeroPedido
                                </span>
                            </td>

                            <td class="px-4 py-4 text-on-surface-variant">
                                @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="px-4 py-4">

                                <span class="inline-flex items-center
                                    px-3 py-1 rounded-full
                                    bg-earth-cream/60
                                    text-coffee-bean text-sm font-medium">
                                    @pedido.Estado
                                </span>

                            </td>

                            <td class="px-4 py-4 text-right font-semibold">
                                @pedido.Total.ToString("C")
                            </td>

                            <td class="px-4 py-4 text-center">

                                <a asp-page="/Pedidos/Confirmacion"
                                   asp-route-id="@pedido.Id"
                                   class="inline-flex items-center gap-1
                                    text-primary hover:text-gold-accent
                                    transition-colors font-medium">

                                    <span class="material-symbols-outlined">
                                        visibility
                                    </span>

                                    Ver
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
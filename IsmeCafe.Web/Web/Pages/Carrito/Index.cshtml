@page
@model Web.Pages.Carrito.IndexModel
@{
    ViewData["Title"] = "Mi carrito";
}

<div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter py-8">
    <h1 class="text-headline-lg font-headline-lg text-coffee-bean mb-6">Mi carrito</h1>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="mb-4 rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant px-4 py-3">
            @Model.Mensaje
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="mb-4 rounded-lg border border-red-300 bg-red-50 text-red-700 px-4 py-3">
            @Model.Error
        </div>
    }

    @if (Model.Carrito.Items == null || !Model.Carrito.Items.Any())
    {
        <div class="rounded-lg border border-outline-variant bg-surface-container-low text-on-surface-variant px-6 py-8 text-center">
            <p class="text-lg mb-4">Tu carrito está vacío.</p>
            <a asp-page="/Productos/Index"
               class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-full text-label-bold font-label-bold hover:bg-primary/90 transition-colors">
                Ver catálogo
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border border-outline-variant bg-white">
            <table class="w-full text-left">
                <thead class="bg-earth-cream/40 text-coffee-bean">
                    <tr>
                        <th class="px-4 py-3">Producto</th>
                        <th class="px-4 py-3 text-right">Precio</th>
                        <th class="px-4 py-3 text-center">Cantidad</th>
                        <th class="px-4 py-3 text-right">Subtotal</th>
                        <th class="px-4 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Carrito.Items)
                    {
                        <tr class="border-t border-outline-variant">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <img src="@item.Imagen" alt="@item.Nombre" class="w-14 h-14 object-cover rounded" onerror="this.src='/img/productos/default.png'" />
                                    <div>
                                        <div class="font-semibold text-coffee-bean">@item.Nombre</div>
                                        <div class="text-xs text-on-surface-variant">Stock: @item.StockDisponible</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right">@item.Precio.ToString("C")</td>
                            <td class="px-4 py-3 text-center">
                                <form method="post" asp-page-handler="Actualizar" class="inline-flex items-center gap-2">
                                    <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@item.StockDisponible"
                                           class="w-20 px-2 py-1 border border-outline-variant rounded text-center" />
                                    <button type="submit"
                                            class="bg-primary text-on-primary px-3 py-1 rounded text-sm hover:bg-primary/90">
                                        Actualizar
                                    </button>
                                </form>
                            </td>
                            <td class="px-4 py-3 text-right font-semibold">@item.Subtotal.ToString("C")</td>
                            <td class="px-4 py-3 text-center">
                                <form method="post" asp-page-handler="Eliminar" class="inline">
                                    <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                    <button type="submit" class="text-red-600 hover:text-red-800" title="Eliminar">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="bg-earth-cream/30 border-t border-outline-variant">
                        <td colspan="3" class="px-4 py-3 text-right font-semibold">Subtotal</td>
                        <td class="px-4 py-3 text-right font-bold text-lg text-coffee-bean">
                            @Model.Carrito.Total.ToString("C")
                        </td>
                        <td></td>
                    </tr>

                    @if (Model.Carrito.PuntosDisponibles > 0)
                    {
                        <tr class="bg-secondary-container/20">
                            <td colspan="5" class="px-4 py-3">
                                <form method="get" class="flex items-center gap-2">
                                    <input type="checkbox" id="usarPuntosCheck" name="UsarPuntos" value="true"
                                    @(Model.UsarPuntos ? "checked" : "")
                                           onchange="this.form.submit()"
                                           class="w-4 h-4 accent-secondary" />
                                    <label for="usarPuntosCheck" class="text-sm text-on-surface cursor-pointer">
                                        Usar mis puntos disponibles
                                        (<span class="font-bold text-secondary">@Model.Carrito.PuntosDisponibles pts</span>)
                                    </label>
                                </form>
                            </td>
                        </tr>
                    }

                    @if (Model.Carrito.DescuentoPuntos > 0)
                    {
                        <tr class="bg-secondary-container/30">
                            <td colspan="3" class="px-4 py-2 text-right text-sm text-secondary font-bold">
                                Descuento por @Model.Carrito.PuntosAUsar puntos canjeados
                            </td>
                            <td class="px-4 py-2 text-right text-sm font-bold text-secondary">
                                -@Model.Carrito.DescuentoPuntos.ToString("C")
                            </td>
                            <td></td>
                        </tr>
                    }

                    <tr class="bg-earth-cream/30 border-t border-outline-variant">
                        <td colspan="3" class="px-4 py-3 text-right font-semibold">Total a pagar</td>
                        <td class="px-4 py-3 text-right font-bold text-lg text-coffee-bean">
                            @Model.Carrito.TotalConDescuento.ToString("C")
                        </td>
                        <td></td>
                    </tr>

                    @if (Model.Carrito.PuntosAGanar > 0)
                    {
                        <tr class="bg-secondary-container/30">
                            <td colspan="3" class="px-4 py-2 text-right text-sm text-secondary font-bold">
                                Puntos que ganarás con esta compra
                            </td>
                            <td class="px-4 py-2 text-right text-sm font-bold text-secondary flex items-center justify-end gap-1">
                                <span class="material-symbols-outlined" style="font-size:16px">stars</span>
                                +@Model.Carrito.PuntosAGanar pts
                            </td>
                            <td></td>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>

        <div class="flex justify-end mt-6">
            <form method="post" asp-page-handler="Confirmar">
                <input type="hidden" name="usarPuntos" value="@(Model.UsarPuntos ? "true" : "false")" />
                <button type="submit"
                        class="bg-primary text-on-primary px-6 py-3 rounded-full text-label-bold font-label-bold hover:bg-primary/90 transition-colors">
                    Confirmar pedido
                </button>
            </form>
        </div>
    }
</div>

@page
@model Web.Pages.Servicios.Admin.GestionServiciosModel

@{
    ViewData["Title"] = "Detalle del Servicio";
    var servicio = Model.Servicios.FirstOrDefault();
}

<div class="max-w-5xl mx-auto px-4 py-10">

    @if (servicio == null)
    {
        <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-10 text-center shadow-sm">

            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-earth-cream flex items-center justify-center">
                <span class="material-symbols-outlined text-coffee-bean"
                      style="font-size:32px">
                    search_off
                </span>
            </div>

            <h1 class="text-headline-md font-headline-md text-coffee-bean">
                Servicio no encontrado
            </h1>

            <p class="mt-2 text-on-surface-variant">
                No fue posible encontrar la información del servicio solicitado.
            </p>

            <a href="javascript:history.back()"
               class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-full border border-outline-variant text-on-surface hover:bg-earth-cream transition-colors">

                <span class="material-symbols-outlined">
                    arrow_back
                </span>

                Volver
            </a>

        </div>
    }
    else
    {
        <div class="mb-6">

            <a href="javascript:history.back()"
               class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">

                <span class="material-symbols-outlined">
                    arrow_back
                </span>

                Volver a servicios
            </a>

        </div>

        <section class="bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-sm overflow-hidden">

            <div class="bg-earth-cream/50 px-6 md:px-8 py-8 border-b border-outline-variant">

                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">

                    <div>

                        <p class="text-label-bold font-label-bold uppercase tracking-wider text-secondary mb-2">
                            Experiencia Isme Café
                        </p>

                        <h1 class="text-headline-lg font-headline-lg text-coffee-bean">
                            @servicio.Nombre
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                        {
                            <p class="mt-3 text-body-md text-on-surface-variant max-w-2xl leading-relaxed">
                                @servicio.Descripcion
                            </p>
                        }

                    </div>

                    @if (servicio.Activo)
                    {
                        <span class="inline-flex items-center gap-2 self-start bg-status-success/10 text-status-success px-4 py-2 rounded-full text-label-bold font-label-bold">

                            <span class="w-2 h-2 rounded-full bg-status-success"></span>

                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-2 self-start bg-status-error/10 text-status-error px-4 py-2 rounded-full text-label-bold font-label-bold">

                            <span class="w-2 h-2 rounded-full bg-status-error"></span>

                            No disponible
                        </span>
                    }

                </div>

            </div>

            <div class="p-6 md:p-8">

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

                    <div class="bg-surface-container-low rounded-xl p-5">

                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-primary">
                                schedule
                            </span>
                        </div>

                        <p class="text-body-sm text-on-surface-variant">
                            Duración
                        </p>

                        <p class="mt-1 text-headline-sm font-headline-sm text-coffee-bean">
                            @servicio.Duracion min
                        </p>

                    </div>

                    <div class="bg-surface-container-low rounded-xl p-5">

                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-primary">
                                payments
                            </span>
                        </div>

                        <p class="text-body-sm text-on-surface-variant">
                            Precio
                        </p>

                        <p class="mt-1 text-headline-sm font-headline-sm text-coffee-bean">
                            ₡@servicio.Precio.ToString("N0")
                        </p>

                    </div>

                    <div class="bg-surface-container-low rounded-xl p-5">

                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-primary">
                                groups
                            </span>
                        </div>

                        <p class="text-body-sm text-on-surface-variant">
                            Cupo máximo
                        </p>

                        <p class="mt-1 text-headline-sm font-headline-sm text-coffee-bean">
                            @servicio.CupoMaximo personas
                        </p>

                    </div>

                    <div class="bg-surface-container-low rounded-xl p-5">

                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-primary">
                                category
                            </span>
                        </div>

                        <p class="text-body-sm text-on-surface-variant">
                            Grupo
                        </p>

                        <p class="mt-1 font-semibold text-coffee-bean">
                            @servicio.Grupo
                        </p>

                    </div>

                </div>

                <div class="mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 pt-6 border-t border-outline-variant">

                    <div class="text-body-sm text-on-surface-variant">

                        <p>
                            Creado el @servicio.FechaCreacion.ToString("dd/MM/yyyy")
                        </p>

                        @if (servicio.FechaActualizacion.HasValue)
                        {
                            <p class="mt-1">
                                Actualizado el @servicio.FechaActualizacion.Value.ToString("dd/MM/yyyy")
                            </p>
                        }

                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">

                        <a href="javascript:history.back()"
                           class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border border-outline-variant text-on-surface hover:bg-earth-cream transition-colors">

                            <span class="material-symbols-outlined">
                                arrow_back
                            </span>

                            Volver
                        </a>

                        @if (servicio.Activo)
                        {
                            <a asp-page="/Reservas/Crear"
                               asp-route-idServicio="@servicio.Id"
                               class="inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-6 py-2.5 rounded-full font-label-bold text-label-bold hover:bg-primary/90 transition-colors">

                                <span class="material-symbols-outlined">
                                    event_available
                                </span>

                                Reservar servicio
                            </a>
                        }

                    </div>

                </div>

            </div>

        </section>
    }

</div>
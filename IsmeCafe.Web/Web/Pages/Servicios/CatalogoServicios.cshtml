@page
@model Web.Pages.Servicios.Admin.GestionServiciosModel

@{
    ViewData["Title"] = "Catálogo de Servicios";
}

<partial name="_hero" />

<div class="max-w-7xl mx-auto px-4 py-10">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">

        <div>
            <p class="text-label-bold font-label-bold uppercase tracking-wider text-secondary mb-1">
                Experiencias Isme Café
            </p>

            <h1 class="text-headline-lg font-headline-lg text-coffee-bean">
                Catálogo de Servicios
            </h1>

            <p class="text-body-md text-on-surface-variant mt-2 max-w-2xl">
                Descubre nuestras experiencias y servicios relacionados con el mundo del café.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-page="/Servicios/Admin/GestionServicios"
               class="inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-full text-label-bold font-label-bold hover:bg-primary/90 transition-colors self-start sm:self-auto">

                <span class="material-symbols-outlined">
                    settings
                </span>

                Administrar

            </a>
        }

    </div>

    @if (Model.Servicios == null || !Model.Servicios.Any())
    {
        <div class="bg-surface-container-lowest border border-outline-variant rounded-2xl p-12 text-center">

            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-earth-cream flex items-center justify-center">
                <span class="material-symbols-outlined text-coffee-bean"
                      style="font-size:32px">
                    local_cafe
                </span>
            </div>

            <h2 class="text-headline-sm font-headline-sm text-coffee-bean">
                No hay servicios disponibles
            </h2>

            <p class="text-body-md text-on-surface-variant mt-2">
                Próximamente tendremos nuevas experiencias para ti.
            </p>

        </div>
    }
    else
    {
        <!-- Tarjetas -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

            @foreach (var servicio in Model.Servicios)
            {
                <article class="group bg-surface-container-lowest border border-outline-variant rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">

                    <div class="bg-earth-cream/60 p-6 border-b border-outline-variant">

                        <div class="flex items-start justify-between gap-4">

                            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">

                                <span class="material-symbols-outlined text-primary"
                                      style="font-size:26px">
                                    local_cafe
                                </span>

                            </div>

                            @if (servicio.Activo)
                            {
                                <span class="inline-flex items-center gap-1 bg-status-success/10 text-status-success px-3 py-1 rounded-full text-xs font-bold">

                                    <span class="w-2 h-2 rounded-full bg-status-success"></span>

                                    Disponible
                                </span>
                            }

                        </div>

                        <h2 class="text-headline-sm font-headline-sm text-coffee-bean mt-5">
                            @servicio.Nombre
                        </h2>

                        @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                        {
                            <p class="text-body-sm text-on-surface-variant mt-2 line-clamp-2">
                                @servicio.Descripcion
                            </p>
                        }

                    </div>

                    <div class="p-6">

                        <div class="grid grid-cols-2 gap-4 mb-6">

                            <div class="flex items-center gap-3">

                                <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center">

                                    <span class="material-symbols-outlined text-secondary">
                                        schedule
                                    </span>

                                </div>

                                <div>
                                    <p class="text-xs text-on-surface-variant">
                                        Duración
                                    </p>

                                    <p class="font-semibold text-coffee-bean">
                                        @servicio.Duracion min
                                    </p>
                                </div>

                            </div>

                           
                            <div class="flex items-center gap-3">

                                <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center">

                                    <span class="material-symbols-outlined text-secondary">
                                        groups
                                    </span>

                                </div>

                                <div>
                                    <p class="text-xs text-on-surface-variant">
                                        Cupo máximo
                                    </p>

                                    <p class="font-semibold text-coffee-bean">
                                        @servicio.CupoMaximo personas
                                    </p>
                                </div>

                            </div>

                        </div>

                        <div class="flex items-end justify-between gap-4 pt-5 border-t border-outline-variant">

                            <div>
                                <p class="text-xs text-on-surface-variant">
                                    Precio
                                </p>

                                <p class="text-headline-sm font-headline-sm text-primary">
                                    ₡@servicio.Precio.ToString("N0")
                                </p>
                            </div>

                            <a asp-page="/Servicios/ServiciosDetalle"
                               asp-route-id="@servicio.Id"
                               class="inline-flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-full font-label-bold text-label-bold hover:bg-primary/90 transition-all">

                                Ver detalles

                                <span class="material-symbols-outlined"
                                      style="font-size:18px">
                                    arrow_forward
                                </span>

                            </a>

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>